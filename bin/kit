#!/usr/bin/env bash
# kit <command>: agent-kit CLI.
#   kit sync [dir]   install the stacks configured in <dir>/.agent-kit.json (default: current git toplevel)
#   kit doctor       check install links, dependencies, and the current project's kit version
#   kit version      print the kit version
set -eu

# Resolve the real location through the ~/.local/bin/kit symlink (no readlink -f on older macOS).
src=$0
while [ -L "$src" ]; do
  target=$(readlink "$src")
  case "$target" in /*) src=$target ;; *) src=$(dirname "$src")/$target ;; esac
done
KIT_DIR=$(cd "$(dirname "$src")/.." && pwd)
. "$KIT_DIR/bin/lib.sh"
for adapter in "$KIT_DIR"/adapters/*.sh; do . "$adapter"; done

kit_commit() { git -C "$KIT_DIR" rev-parse --short HEAD 2>/dev/null || echo unknown; }
adapter_names() { for a in "$KIT_DIR"/adapters/*.sh; do basename "$a" .sh; done; }
# stack_dirs <root>: prints "<dir>\t<stack>" per entry of .stacks in .agent-kit.json.
stack_dirs() { jq -r '.stacks // {} | to_entries[] | "\(.key)\t\(.value)"' "$1/.agent-kit.json"; }

# with_header <source> <kit-relative name>: prints the file with a generated header in its comment syntax.
with_header() {
  local h
  h=$(generated_header "$2")
  case "$1" in
    *.md) printf '<!-- %s -->\n' "$h"; cat "$1" ;;
    *.mjs|*.js) printf '// %s\n' "$h"; cat "$1" ;;
    *.sh) head -n 1 "$1"; printf '# %s\n' "$h"; tail -n +2 "$1" ;;
    *) printf '# %s\n' "$h"; cat "$1" ;;
  esac
}

# put <content file> <destination>: write only when the content changed.
put() {
  [ -f "$2" ] && cmp -s "$1" "$2" && return 0
  say "write ${2#"$ROOT"/}"
  _write_now "$1" "$2"
}

sync_stack_copies() {
  local staging stack f rel
  staging=$(mktemp -d)
  for stack in $(stack_dirs "$ROOT" | cut -f2 | LC_ALL=C sort -u); do
    (cd "$KIT_DIR/stacks/$stack" && find . -type f | LC_ALL=C sort) | while IFS= read -r rel; do
      rel=${rel#./}
      f=$staging/$stack/$rel
      mkdir -p "$(dirname "$f")"
      with_header "$KIT_DIR/stacks/$stack/$rel" "stacks/$stack/$rel" > "$f"
      case "$rel" in *.sh) chmod +x "$f" ;; esac
    done
  done
  if ! diff -r "$staging" "$ROOT/.agent-kit/stacks" >/dev/null 2>&1; then
    say "write .agent-kit/stacks/"
    rm -rf "$ROOT/.agent-kit/stacks"
    mkdir -p "$ROOT/.agent-kit"
    cp -R "$staging" "$ROOT/.agent-kit/stacks"
  fi
  rm -rf "$staging"
}

# sync_agents_md <dir> <stack>: replace or append the stack's marker block in <dir>/AGENTS.md.
sync_agents_md() {
  local dir=$1 stack=$2 file=$ROOT/$1/AGENTS.md block out up
  local begin="<!-- agent-kit:begin $stack -->" end="<!-- agent-kit:end $stack -->"
  up=$(printf '%s' "$dir" | sed -e 's|^\./||' -e 's|/$||' -e 's|[^/][^/]*|..|g')
  [ -n "$up" ] && [ "$dir" != . ] || up=.
  block=$(mktemp)
  out=$(mktemp)
  {
    echo "$begin"
    printf '<!-- %s Edit outside these markers only; kit sync rewrites this block. -->\n' "$(generated_header "stacks/$stack/rules.md")"
    cat "$KIT_DIR/stacks/$stack/rules.md"
    echo
    echo "Inventory: \`docs/inventory/$stack.md\` (refresh with \`$up/.agent-kit/stacks/$stack/registry.sh .\`)."
    echo "Checks: \`scripts/verify.sh fast\` after each change and \`scripts/verify.sh full\` before done, from the repository root."
    echo "$end"
  } > "$block"
  touch "$file"
  if grep -qxF "$begin" "$file"; then
    awk -v b="$begin" -v e="$end" -v f="$block" '
      $0 == b { while ((getline l < f) > 0) print l; skip = 1; next }
      $0 == e && skip { skip = 0; next }
      !skip { print }' "$file" > "$out"
  else
    { cat "$file"; [ -s "$file" ] && echo; cat "$block"; } > "$out"
  fi
  put "$out" "$file"
  rm -f "$block" "$out"
}

sync_verify_script() {
  local dest=$ROOT/scripts/verify.sh tmp dir stack
  if [ -f "$dest" ] && ! is_generated "$dest"; then
    warn "scripts/verify.sh exists and was not generated by agent-kit; left unchanged."
    warn "Make it run .agent-kit/stacks/<stack>/verify.sh <mode> inside each stack directory."
    return 0
  fi
  tmp=$(mktemp)
  {
    echo '#!/usr/bin/env bash'
    echo "# $(generated_header "kit sync") Run kit sync to change it."
    echo '# verify.sh fast|full: runs every stack check; exits 1 if any failed.'
    echo 'set -u'
    echo 'mode=${1:-fast}'
    echo 'root=$(cd "$(dirname "$0")/.." && pwd)'
    echo 'status=0'
    stack_dirs "$ROOT" | while IFS="$(printf '\t')" read -r dir stack; do
      echo "(cd \"\$root/$dir\" && \"\$root/.agent-kit/stacks/$stack/verify.sh\" \"\$mode\") || status=1"
    done
    echo 'exit $status'
  } > "$tmp"
  put "$tmp" "$dest"
  chmod +x "$dest"
  rm -f "$tmp"
}

sync_pre_commit() {
  local hooks hook tmp
  hooks=$(cd "$ROOT" && git rev-parse --git-path hooks)
  case "$hooks" in /*) ;; *) hooks=$ROOT/$hooks ;; esac
  hook=$hooks/pre-commit
  if [ -f "$hook" ] && ! is_generated "$hook"; then
    warn "a pre-commit hook already exists; add this line to it: \"\$(git rev-parse --show-toplevel)/scripts/verify.sh\" fast"
    return 0
  fi
  tmp=$(mktemp)
  printf '#!/bin/sh\n# %s\nexec "$(git rev-parse --show-toplevel)/scripts/verify.sh" fast\n' "$(generated_header "kit sync")" > "$tmp"
  put "$tmp" "$hook"
  chmod +x "$hook"
  rm -f "$tmp"
}

cmd_sync() {
  ROOT=$(cd "${1:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}" && pwd)
  if [ ! -f "$ROOT/.agent-kit.json" ]; then
    echo "No .agent-kit.json in $ROOT. Create one, for example:" >&2
    echo '{"kit_version": "'"$KIT_VERSION"'", "stacks": {"frontend": "nextjs", "backend": "fastapi"}}' >&2
    exit 1
  fi
  local dir stack tool tmp f
  stack_dirs "$ROOT" | while IFS="$(printf '\t')" read -r dir stack; do
    [ -d "$KIT_DIR/stacks/$stack" ] || { echo "unknown stack '$stack' for $dir; available: $(ls "$KIT_DIR/stacks" | tr '\n' ' ')" >&2; exit 1; }
    [ -d "$ROOT/$dir" ] || { echo "directory $dir from .agent-kit.json does not exist" >&2; exit 1; }
  done
  # Recorded first: registry.sh puts this version in the inventory headers.
  tmp=$(mktemp)
  jq --arg v "$KIT_VERSION" --arg c "$(kit_commit)" '.kit_version = $v | .kit_commit = $c' "$ROOT/.agent-kit.json" > "$tmp"
  put "$tmp" "$ROOT/.agent-kit.json"
  rm -f "$tmp"
  sync_stack_copies
  stack_dirs "$ROOT" | while IFS="$(printf '\t')" read -r dir stack; do
    sync_agents_md "$dir" "$stack"
    "$ROOT/.agent-kit/stacks/$stack/registry.sh" "$ROOT/$dir" >/dev/null
  done
  sync_verify_script
  sync_pre_commit
  for tool in $(adapter_names); do "${tool}_sync_project" "$ROOT"; done
  for f in "$ROOT"/.agent-kit/stacks/*/lint/*; do
    say "lint: extend ${f#"$ROOT"/} from the project's own config (the file header shows the line to add)"
  done
  say "synced $ROOT with agent-kit $KIT_VERSION ($(kit_commit))"
}

cmd_doctor() {
  local problems=0 tool dep root dir stack v c
  for dep in git jq; do
    command -v "$dep" >/dev/null 2>&1 || { say "missing dependency: $dep"; problems=$((problems + 1)); }
  done
  for tool in $(adapter_names); do
    "${tool}_detect" || continue
    "${tool}_doctor" || problems=$((problems + $?))
  done
  root=$(git rev-parse --show-toplevel 2>/dev/null || true)
  if [ -n "$root" ] && [ -f "$root/.agent-kit.json" ] && command -v jq >/dev/null 2>&1; then
    v=$(jq -r '.kit_version // "none"' "$root/.agent-kit.json")
    c=$(jq -r '.kit_commit // "none"' "$root/.agent-kit.json")
    if [ "$v" != "$KIT_VERSION" ] || [ "$c" != "$(kit_commit)" ]; then
      say "project synced with agent-kit $v ($c), kit is $KIT_VERSION ($(kit_commit)): run kit sync"
      problems=$((problems + 1))
    fi
    while IFS="$(printf '\t')" read -r dir stack; do
      if ! grep -qxF "<!-- agent-kit:begin $stack -->" "$root/$dir/AGENTS.md" 2>/dev/null; then
        say "missing $stack block in $dir/AGENTS.md: run kit sync"
        problems=$((problems + 1))
      fi
    done <<EOF
$(stack_dirs "$root")
EOF
  fi
  if [ "$problems" = 0 ]; then say "kit doctor: all good"; else say "kit doctor: $problems problem(s)"; fi
  [ "$problems" = 0 ]
}

case "${1:-}" in
  sync) shift; cmd_sync "$@" ;;
  doctor) cmd_doctor ;;
  version) say "agent-kit $KIT_VERSION ($(kit_commit))" ;;
  *) sed -n '2,/^set/p' "$src" | sed '$d' | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
